# Copy to .env and adjust values

# --- Core ---
ENV=development
LOG_LEVEL=INFO
TZ=UTC

# --- API Gateway ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_GATEWAY_URL=http://api:8000

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
BOT_POLL_INTERVAL_SECONDS=3
BOT_POLL_TIMEOUT_SECONDS=120

# --- Database ---
POSTGRES_DB=threadmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/threadmind

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=200

# --- AI Providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Alembic ---
ALEMBIC_SCRIPT_LOCATION=app/db/migrations

# --- Telegram (Telethon) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_FETCH_LIMIT=200
TELEGRAM_REQUIRE_REAL_FETCH=false
